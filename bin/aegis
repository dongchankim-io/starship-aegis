#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# 🛰️ aegis — Theme Switcher & HUD Demo CLI for Starship Aegis
# Author: Dongchan Kim (@dongchankim-io)
# ==============================================================================

CONFIG_FILE="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"
PALETTES=("catppuccin_mocha" "tokyo_night" "kanagawa" "rose_pine" "gruvbox_material" "nord")

usage() {
  cat <<EOF
🛰️  Starship Aegis CLI (@dongchankim-io)

Usage:
  aegis theme <palette>   Switch active 24-bit color palette
  aegis list              List built-in palettes
  aegis demo              Preview all 5 HUD operational states in your terminal

Available Palettes:
  - catppuccin_mocha (default)
  - tokyo_night
  - kanagawa
  - rose_pine
  - gruvbox_material
  - nord
EOF
}

cmd_list() {
  current=$(grep -E '^palette\s*=' "$CONFIG_FILE" | sed -E 's/.*"([^"]+)".*/\1/' || echo "unknown")
  echo "Available Starship Aegis Palettes:"
  for p in "${PALETTES[@]}"; do
    if [ "$p" = "$current" ]; then
      echo -e "  \033[1;32m● $p (active)\033[0m"
    else
      echo "  ○ $p"
    fi
  done
}

cmd_theme() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    usage
    exit 1
  fi
  local valid=0
  for p in "${PALETTES[@]}"; do
    [[ "$p" == "$target" ]] && valid=1 && break
  done
  if [ "$valid" -eq 0 ]; then
    echo -e "\033[1;31mUnknown palette: $target\033[0m"
    cmd_list
    exit 1
  fi

  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' -E "s/^palette = \".*\"/palette = \"${target}\"/" "$CONFIG_FILE"
  else
    sed -i -E "s/^palette = \".*\"/palette = \"${target}\"/" "$CONFIG_FILE"
  fi
  echo -e "\033[1;32m✓ Switched Starship Aegis palette to:\033[0m \033[1;36m${target}\033[0m"
}

cmd_demo() {
  echo -e "\n\033[1;37m━━━ 🛰️  STARSHIP AEGIS — MULTI-SERVER HUD PREVIEW ━━━\033[0m\n"

  echo -e "\033[0;90m# 1. Local Development (Repo-Root Highlight + Live Diff Gauge + Runtimes)\033[0m"
  echo -e "\033[0;90m╭─ \033[38;2;49;50;68m\033[48;2;49;50;68m\033[38;2;205;214;244m󰀵 \033[1;38;2;137;180;250mdonk\033[0;48;2;49;50;68m\033[38;2;88;91;112m@\033[1;38;2;249;226;175mmacbook\033[0m\033[38;2;49;50;68m\033[0m \033[38;2;88;91;112m~/work/\033[1;4;38;2;116;199;236maegis-core\033[0m\033[1;38;2;137;220;235m/src/api\033[0m \033[1;38;2;203;166;247m main\033[0m \033[1;38;2;249;226;175m[!2 +1 ⇡1]\033[0m \033[1;38;2;166;227;161m+48\033[0m/\033[1;38;2;243;139;168m-12\033[0m \033[1;38;2;250;179;135m 1.82.0\033[0m"
  echo -e "\033[0;90m╰─ \033[1;38;2;166;227;161m❯\033[0m cargo test --workspace\n"

  echo -e "\033[0;90m# 2. Remote SSH Server + Persistent Tmux Multiplexer + Internal IP\033[0m"
  echo -e "\033[0;90m╭─ \033[38;2;49;50;68m\033[48;2;49;50;68m\033[38;2;205;214;244m󰕈 \033[1;38;2;137;180;250mubuntu\033[0;48;2;49;50;68m\033[38;2;88;91;112m@\033[1;38;2;249;226;175mworker-us-east-04 󰣀\033[0;48;2;49;50;68m\033[38;2;166;173;200m · 10.24.8.19\033[0m\033[38;2;49;50;68m\033[0m \033[38;2;49;50;68m\033[1;48;2;49;50;68m\033[38;2;166;227;161m tmux\033[0m\033[38;2;49;50;68m\033[0m \033[1;38;2;137;220;235m/var/log/envoy\033[0m \033[38;2;243;139;168m󰌾\033[0m"
  echo -e "\033[0;90m╰─ \033[1;38;2;166;227;161m❯\033[0m tail -f access.log\n"

  echo -e "\033[0;90m# 3. Production Root Escalation + Nested Shell Warning + Active Sudo Key\033[0m"
  echo -e "\033[0;90m╭─ \033[38;2;49;50;68m\033[48;2;49;50;68m\033[38;2;205;214;244m󱄛 \033[1;48;2;243;139;168m\033[38;2;17;17;27mroot\033[0;48;2;49;50;68m\033[38;2;88;91;112m@\033[1;38;2;249;226;175mprod-db-primary-01 󰣀\033[0;48;2;49;50;68m\033[38;2;166;173;200m · 172.16.0.10\033[0m\033[38;2;49;50;68m\033[0m \033[38;2;243;139;168m\033[1;48;2;243;139;168m\033[38;2;17;17;27m🚨 PROD\033[0m\033[38;2;243;139;168m\033[0m \033[1;38;2;203;166;247m↕2\033[0m \033[1;38;2;137;220;235m/etc/postgresql/16/main\033[0m"
  echo -e "\033[0;90m╰─ \033[1;38;2;243;139;168m󰌆 \033[1;38;2;166;227;161m❯\033[0m systemctl reload postgresql\n"

  echo -e "\033[0;90m# 4. Interactive Git Rebase + Signal / Exit Code Diagnostics\033[0m"
  echo -e "\033[0;90m╭─ \033[38;2;49;50;68m\033[48;2;49;50;68m\033[38;2;205;214;244m󰀵 \033[1;38;2;137;180;250mdonk\033[0;48;2;49;50;68m\033[38;2;88;91;112m@\033[1;38;2;249;226;175mmacbook\033[0m\033[38;2;49;50;68m\033[0m \033[1;4;38;2;116;199;236maegis-core\033[0m \033[1;38;2;166;227;161m(a1b2c3d 🏷 v2.1.0)\033[0m \033[38;2;249;226;175m\033[1;48;2;249;226;175m\033[38;2;17;17;27mREBASING 3/7\033[0m\033[38;2;249;226;175m\033[0m \033[1;38;2;249;226;175m[⚡2]\033[0m"
  echo -e "\033[0;90m╰─ \033[1;38;2;137;180;250m✦1 \033[0m\033[38;2;243;139;168m\033[1;48;2;243;139;168m\033[38;2;17;17;27m⚡ SIGKILL\033[0m\033[38;2;243;139;168m\033[0m \033[1;38;2;243;139;168m❯\033[0m \n"
}

case "${1:-}" in
  theme) cmd_theme "${2:-}" ;;
  list)  cmd_list ;;
  demo)  cmd_demo ;;
  *)     usage ;;
esac
